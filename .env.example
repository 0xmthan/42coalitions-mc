# Copy to .env and fill in -- credentials from
# https://profile.intra.42.fr/oauth/applications
#
# This file is read from plugins/Coalitions/.env, the server root, or the repo
# root. Real environment variables win over it.
FT_CLIENT_ID=your_application_uid
FT_CLIENT_SECRET=your_application_secret

# Can also be set as intra.campus-id in config.yml.
FT_CAMPUS_ID=49
